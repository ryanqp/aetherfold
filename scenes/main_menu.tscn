theme_override_constants/separation = 12

[node name="SettingsBackBtn" type="Button" parent="PageSettings/Col/BackRow"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(160, 48)
theme_override_font_sizes/font_size = 20
theme_override_styles/normal = SubResource("SB_gray_btn")
theme_override_colors/font_color = Color(0.93, 0.93, 0.9, 1)
text = "Back"

[connection signal="pressed" from="PageHub/Col/ButtonWrap/ExitBtn" to="." method="_on_exit"]
[connection signal="pressed" from="PageVs/Col/BackRow/VsStartMatchBtn" to="." method="_on_start_vs"]
[connection signal="item_selected" from="PageVs/Col/DiffRow/DiffOption" to="." method="_on_diff_selected"]
[connection signal="pressed" from="PageMp/Col/RoomRow/CreateRoomBtn" to="." method="_on_mp_host"]
[connection signal="pressed" from="PageMp/Col/RoomRow/JoinRoomBtn" to="." method="_on_mp_join"]
[connection signal="pressed" from="PageMp/Col/BackRow/MpStartMatchBtn" to="." method="_on_mp_start"]
[connection signal="pressed" from="PageLibrary/Col/ButtonWrap/ImportBtn" to="." method="_on_open_import"]
[connection signal="pressed" from="PageBuilder/Col/ActionRow/RemoveSelectedBtn" to="." method="_on_remove_card"]
[connection signal="pressed" from="PageBuilder/Col/ActionRow/SaveToGalleryBtn" to="." method="_on_save_builder"]
[connection signal="text_changed" from="PageBuilder/Col/BuilderCmd" to="." method="_on_cmd_search"]
[connection signal="item_selected" from="PageBuilder/Col/BuilderCmdList" to="." method="_on_cmd_pick"]
[connection signal="text_submitted" from="PageBuilder/Col/BuilderCard" to="." method="_on_add_card"]
[connection signal="pressed" from="PageSettings/Col/SettingsMusicBtn" to="." method="_toggle_music"]
[connection signal="pressed" from="PageSettings/Col/SettingsSfxBtn" to="." method="_toggle_sfx"]
[connection signal="pressed" from="PageSettings/Col/ToggleFullscreenBtn" to="." method="_toggle_fullscreen"]
