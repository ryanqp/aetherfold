class_name EngineEnums
extends RefCounted

## Shared enumerations for the rules kernel. Values are stored as ints on GameState.

enum ZoneId {
	LIBRARY,
	HAND,
	BATTLEFIELD,
	GRAVEYARD,
	EXILE,
	STACK,
	COMMAND,
}

enum Phase {
	UNTAP,
	UPKEEP,
	DRAW,
	MAIN_1,
	COMBAT,
	MAIN_2,
	ENDING,
}

enum Step {
	UNTAP,
	UPKEEP,
	DRAW,
	PRECOMBAT_MAIN,
	BEGIN_COMBAT,
	DECLARE_ATTACKERS,
	DECLARE_BLOCKERS,
	COMBAT_DAMAGE,
	END_COMBAT,
	POSTCOMBAT_MAIN,
	END,
	CLEANUP,
}

enum EngineMode {
	GIVING_PRIORITY,
	CASTING,
	ACTIVATING,
	PAYING_COSTS,
	DECLARING_ATTACKERS,
	DECLARING_BLOCKERS,
	ASSIGNING_COMBAT_DAMAGE,
	CHOOSING_SBA,
	CHOOSING_REPLACEMENT,
	GAME_OVER,
}

enum EventType {
	GAME_START,
	ZONE_CHANGE,
	SPELL_CAST,
	ABILITY_ACTIVATED,
	DRAW,
	DAMAGE,
	LIFE_CHANGE,
	PRIORITY,
	STEP_BEGIN,
	STEP_END,
	GAME_OVER,
}
